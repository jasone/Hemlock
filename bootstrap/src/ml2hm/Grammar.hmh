open Basis
open! Basis.Rudiments

include hocc
    # Precedences.

    # Keywords.
    token AND "and"
    token AS "as"
    token ASSERT "assert"
    token BEGIN "begin"
    token ELSE "else"
    token END "end"
    token EXTERNAL "external"
    token FALSE "false"
    token FUN "fun"
    token FUNCTION "function"
    token FUNCTOR "functor"
    token IF "if"
    token IN "in"
    token IMPORT "import"
    token INCLUDE "include"
    token LAZY "lazy"
    token LET "let"
    token MATCH "match"
    token MOD "mod"
    token MODULE "module"
    token MUTABLE "mutable"
    token NONREC "nonrec"
    token OF "of"
    token OPEN "open"
    token OR "or"
    token PRIVATE "private"
    token REC "rec"
    token SIG "sig"
    token STRUCT "struct"
    token THEN "then"
    token TRUE "true"
    token TYPE "type"
    token VAL "val"
    token WHEN "when"
    token WITH "with"

    # Operators.
    # Prefix.
    token TILDE_OP
    token QMARK_OP
    # Infix.
    token STAR_STAR_OP
    token STAR_OP
    token SLASH_OP
    token PCT_OP
    token PLUS_OP
    token MINUS_OP
    token AT_OP
    token CARET_OP
    token DOLLAR_OP
    token LT_OP
    token EQ_OP
    token GT_OP
    token BAR_OP
    token COLON_OP
    token DOT_OP

    # Punctuation.
    token TILDE "~"
    token QMARK "?"
    token STAR "*"
    token PLUS "+"
    token MINUS "-"
    token LT "<"
    token LT_EQ "<="
    token EQ "="
    token LT_GT "<>"
    token GT_EQ ">="
    token GT ">"
    token COMMA ","
    token DOT "."
    token DOT_DOT ".."
    token SEMI ";"
    token COLON ":"
    token COLON_COLON "::"
    token COLON_EQ ":="
    token LPAREN "("
    token RPAREN ")"
    token LBRACK "["
    token RBRACK "]"
    token LCURLY "{"
    token RCURLY "}"
    token BAR "|"
    token LCAPTURE "(|"
    token RCAPTURE "|)"
    token LARRAY "[|"
    token RARRAY "|]"
    token BSLASH "\\"
    token TICK "'"
    token AMP_AMP "&&" # OCaml-specefic.
    token XMARK "!"
    token ARROW "->"

    # Composite.
    token TILDE_UIDENT_COLON
    token QMARK_UIDENT_COLON
    token LBRACKET_AT "[@"
    token LBRACKET_AT_AT "[@@"
    token LBRACKET_AT_AT_AT "[@@@"

    # Miscellaneous.
    token WHITESPACE
    token PAREN_COMMENT
    token USCORE "_"
    token UIDENT
    token CIDENT
    token CODEPOINT
    token QSTRING
    token ISTRING
    token LONG
    token END_OF_INPUT

    nonterm XXX ::= epsilon

    nonterm SingleAttrId ::=
      | UIDENT
      | CIDENT
      | "and"
      | "as"
      | "assert"
      | "begin"
      | "else"
      | "end"
      | "external"
      | "false"
      | "fun"
      | "function"
      | "functor"
      | "if"
      | "in"
      | "include"
      | "lazy"
      | "let"
      | "match"
      | "module"
      | "mutable"
      | "nonrec"
      | "of"
      | "open"
      | "private"
      | "rec"
      | "sig"
      | "struct"
      | "then"
      | "true"
      | "type"
      | "val"
      | "when"
      | "with"

    nonterm Operator ::=
      | TILDE_OP
      | QMARK_OP
      | "!"
      | STAR_STAR_OP
      | STAR_OP
      | SLASH_OP
      | PCT_OP
      | PLUS_OP
      | MINUS_OP
      | AT_OP
      | CARET_OP
      | DOLLAR_OP
      | LT_OP
      | EQ_OP
      | GT_OP
      | BAR_OP
      | COLON_OP
      | DOT_OP
      | "+"
      | "-"
      | "*"
      | "="
      | "<"
      | ">"
      | "&&"
      | ":="

    nonterm ListAttribute ::=
      | Attribute ListAttribute
      | epsilon

    nonterm ListPostItemAttribute ::=
      | PostItemAttribute ListPostItemAttribute
      | epsilon

    nonterm ValExtraIdent ::=
      | "(" Operator ")"

    nonterm Ident ::=
      | UIDENT
      | CIDENT

    nonterm ValIdent ::=
      | UIDENT
      | ValExtraIdent

    nonterm SeqExpr ::=
      | XXX

    nonterm Pattern ::=
      | XXX

    nonterm FunctorArg ::=
      | XXX

    nonterm ReversedNonemptyLlistFunctorArg ::=
      | ReversedNonemptyLlistFunctorArg FunctorArg
      | FunctorArg

    nonterm ModuleExpr ::=
      | XXX

    nonterm MtyLongident ::=
      | XXX

    nonterm WithConstraint ::=
      | XXX

    nonterm ReversedSeparatedNonemptyLlistAndWithConstraint ::=
      | ReversedSeparatedNonemptyLlistAndWithConstraint "and" WithConstraint
      | WithConstraint

    nonterm ModuleType ::=
      | "sig" ListAttribute Signature "end"
      | "functor" ListAttribute ReversedNonemptyLlistFunctorArg "->" ModuleType
      | "module" "type" "of" ListAttribute ModuleExpr
      | "(" ModuleType ")"
      | ModuleType Attribute
      | MtyLongident
      | ModuleType "->" ModuleType
      | ModuleType "with" ReversedSeparatedNonemptyLlistAndWithConstraint

    nonterm LongidentModExtLongidentCident ::=
      | ModExtLongident "." CIDENT
      | CIDENT

    nonterm ModExtLongident ::=
      | ModExtLongident "(" ModExtLongident ")"
      | LongidentModExtLongidentCident

    nonterm TypeLongident ::=
      | ModExtLongident "." UIDENT
      | UIDENT

    nonterm ReversedSeparatedNonemptyLlistCommaCoreType ::=
      | ReversedSeparatedNonemptyLlistCommaCoreType "," CoreType
      | CoreType "," CoreType

    nonterm AtomicType ::=
      | "(" CoreType ")"
      | "(" "module" ListAttribute ModuleType ")"
      | "'" Ident
      | "_"
      | TypeLongident
      | AtomicType TypeLongident
      | "(" ReversedSeparatedNonemptyLlistCommaCoreType ")" TypeLongident

    nonterm ReversedSeparatedNontrivialLlistStarAtomicType ::=
      | ReversedSeparatedNontrivialLlistStarAtomicType "*" AtomicType
      | AtomicType "*" AtomicType

    nonterm TupleType ::=
      | AtomicType
      | ReversedSeparatedNontrivialLlistStarAtomicType

    nonterm OptLabel ::=
      | QMARK_UIDENT_COLON
      | "?" UIDENT ":"

    nonterm FunctionType ::=
      | TupleType
      | OptLabel TupleType "->" FunctionType
      | UIDENT ":" TupleType "->" FunctionType
      | TupleType "->" FunctionType

    nonterm AliasType ::=
      | FunctionType
      | AliasType "as" "'" Ident

    nonterm CoreType ::=
      | AliasType
      | CoreType Attribute

    nonterm ReversedNonEmptyLlistTypevar ::=
      | "'" Ident
      | ReversedNonEmptyLlistTypevar "'" Ident

    nonterm PossiblyPolyCoreType ::=
      | CoreType
      | ReversedNonEmptyLlistTypevar "." CoreType

    nonterm ValueDescription ::=
      | "val" ListAttribute ValIdent ":" PossiblyPolyCoreType ListPostItemAttribute

    nonterm Payload ::=
      | Structure
      | ":" Signature
      | ":" CoreType
      | "?" Pattern
      | "?" Pattern "when" SeqExpr

    nonterm AttrId ::=
      | SingleAttrId
      | SingleAttrId "." AttrId

    nonterm Attribute ::=
      | "[@" AttrId Payload "]"

    nonterm PostItemAttribute ::=
      | "[@@" AttrId Payload "]"

    nonterm FloatingAttribute ::=
      | "[@@@" AttrId Payload "]"

    nonterm SignatureItem ::=
      | FloatingAttribute
      | ValueDescription
      | XXX

    nonterm SignatureListElm ::=
      | SignatureItem SignatureListElm
      | epsilon

    nonterm Signature ::=
      | SignatureListElm

    nonterm Structure ::=
      | XXX

    start Mli ::=
      | Signature END_OF_INPUT

    start Ml ::=
      | Structure END_OF_INPUT
