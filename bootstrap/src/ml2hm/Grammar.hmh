open Basis
open! Basis.Rudiments

include hocc
    # Precedences.

    # Keywords.
    token AND "and"
    token AS "as"
    token ASSERT "assert"
    token BEGIN "begin"
    token ELSE "else"
    token END "end"
    token EXTERNAL "external"
    token FALSE "false"
    token FUN "fun"
    token FUNCTION "function"
    token FUNCTOR "functor"
    token IF "if"
    token IN "in"
    token INCLUDE "include"
    token LAZY "lazy"
    token LET "let"
    token MATCH "match"
    token MOD "mod"
    token MODULE "module"
    token MUTABLE "mutable"
    token NONREC "nonrec"
    token OF "of"
    token OPEN "open"
    token PRIVATE "private"
    token REC "rec"
    token SIG "sig"
    token STRUCT "struct"
    token THEN "then"
    token TRUE "true"
    token TYPE "type"
    token VAL "val"
    token WHEN "when"
    token WITH "with"

    # Operators (and punctuation in cases like `*`).

    # Prefix.
    token TILDE_OP
    token QMARK_OP

    # Infix.
    token STAR_STAR_OP
    token STAR_OP
    token STAR "*"

    token SLASH_OP

    token PCT_OP
    token PCT "\%"

    token PLUS_OP
    token PLUS "+"
    token PLUS_EQ "+="
    token PLUS_DOT "+."

    token MINUS_OP
    token MINUS "-"
    token MINUS_DOT "-."

    token AT_OP

    token CARET_OP

    token DOLLAR_OP

    token LT_OP
    token LT "<"
    token LT_EQ "<="
    token LT_GT "<>"
    token LARROW "<-"

    token EQ_OP
    token EQ "="

    token GT_OP
    token GT_EQ ">="
    token GT ">"

    token AMP_AMP "&&" # OCaml-specefic.

    token BAR_OP

    token COLON_OP
    token COLON_COLON "::"
    token COLON_EQ ":="

    token DOT_OP

    # Punctuation.
    token TILDE "~"
    token QMARK "?"
    token ARROW "->"
    token BAR "|"
    token COLON ":"
    token DOT "."
    token DOT_DOT ".."
    token COMMA ","
    token SEMI ";"
    token LPAREN "("
    token RPAREN ")"
    token LBRACK "["
    token RBRACK "]"
    token LCURLY "{"
    token RCURLY "}"
    token LARRAY "[|"
    token RARRAY "|]"
    token TICK "'"
    token XMARK "!"

    # Composite.
    token TILDE_UIDENT_COLON "~label:"
    token QMARK_UIDENT_COLON "?label:"
    token LBRACKET_AT "[@"
    token LBRACKET_AT_AT "[@@"
    token LBRACKET_AT_AT_AT "[@@@"

    # Miscellaneous.
    token WHITESPACE
    token PAREN_COMMENT
    token USCORE "_"
    token UIDENT
    token CIDENT
    token CODEPOINT
    token QSTRING
    token ISTRING
    token R64
    token LONG
    token END_OF_INPUT

    nonterm PrefixOp ::=
      | TILDE_OP
      | "~"
      | QMARK_OP
      | "?"

    nonterm InfixOp4 ::=
      | STAR_STAR_OP

    nonterm InfixOp3 ::=
      | STAR_OP
      | "*"
      | SLASH_OP
      | PCT_OP
      | "\%"
      | "mod"

    nonterm InfixOp2 ::=
      | MINUS_OP
      | "-"
      | "-."
      | PLUS_OP
      | "+"
      | "+."
      | "+="

    nonterm InfixOp1 ::=
      | AT_OP
      | CARET_OP

    nonterm InfixOp0 ::=
      | BAR_OP
      | DOLLAR_OP
      | LT_OP
      | "<"
      | "<="
      | "<>"
      | EQ_OP
      | "="
      | GT_OP
      | ">="
      | ">"
      | BAR_OP
      | "|"

    nonterm Constant ::=
      | LONG
      | CODEPOINT
      | QSTRING
      | ISTRING
      | R64

    nonterm SignedConstant ::=
      | Constant
      | "-" LONG
      | "-" R64
      | "+" LONG
      | "+" R64

    nonterm UidentList ::=
      | UIDENT UidentList
      | UIDENT

    nonterm SingleAttrId ::=
      | UIDENT
      | CIDENT
      | "and"
      | "as"
      | "assert"
      | "begin"
      | "else"
      | "end"
      | "external"
      | "false"
      | "fun"
      | "function"
      | "functor"
      | "if"
      | "in"
      | "include"
      | "lazy"
      | "let"
      | "match"
      | "module"
      | "mutable"
      | "nonrec"
      | "of"
      | "open"
      | "private"
      | "rec"
      | "sig"
      | "struct"
      | "then"
      | "true"
      | "type"
      | "val"
      | "when"
      | "with"

    nonterm Operator ::=
      | TILDE_OP
      | QMARK_OP
      | "!"
      | STAR_STAR_OP
      | STAR_OP
      | "*"
      | SLASH_OP
      | PCT_OP
      | "\%"
      | PLUS_OP
      | "+"
      | "+."
      | MINUS_OP
      | "-"
      | "-."
      | AT_OP
      | CARET_OP
      | DOLLAR_OP
      | LT_OP
      | "<"
      | EQ_OP
      | "="
      | GT_OP
      | ">"
      | BAR_OP
      | COLON_OP
      | DOT_OP
      | "&&"
      | ":="

    nonterm Subtractive ::=
      | "-"
      | "-."

    nonterm Additive ::=
      | "+"
      | "+."

    nonterm OptionSemi ::=
      | ";"
      | epsilon

    nonterm OptionPrecededColonCoreType ::=
      | ":" CoreType
      | epsilon

    nonterm OptionPrecededEqualPattern ::=
      | "=" Pattern
      | epsilon

    nonterm AttributeList ::=
      | Attribute AttributeList
      | epsilon

    nonterm PostItemAttributeList ::=
      | PostItemAttribute PostItemAttributeList
      | epsilon

    nonterm ValExtraIdent ::=
      | "(" Operator ")"

    nonterm Ident ::=
      | UIDENT
      | CIDENT

    nonterm ValIdent ::=
      | UIDENT
      | ValExtraIdent

    nonterm MatchCase ::=
      | Pattern "->" SeqExpr
      | Pattern "when" SeqExpr "->" SeqExpr
      | Pattern "->" "."

    nonterm MatchCaseList ::=
      | MatchCaseList "|" MatchCase
      | "|" MatchCase
      | MatchCase

    nonterm LabeledSimpleExpr ::=
      | SimpleExpr
      | "~label:" SimpleExpr
      | "~" UIDENT
      | "~" "(" UIDENT ":" CoreType ")"
      | "?" UIDENT
      | "?label:" SimpleExpr

    nonterm LabeledSimpleExprList ::=
      | LabeledSimpleExprList LabeledSimpleExpr
      | LabeledSimpleExpr

    nonterm ExprCommaList ::=
      | ExprCommaList "," Expr
      | Expr "," Expr

    nonterm LabelLetPattern ::=
      | UIDENT ":" CoreType
      | UIDENT

    nonterm OptionPrecededEqualSeqExpr ::=
      | "=" SeqExpr
      | epsilon

    nonterm LetPattern ::=
      | Pattern ":" CoreType
      | Pattern

    nonterm PatternVar ::=
      | UIDENT
      | "_"

    nonterm LabeledSimplePattern ::=
      | "?" "(" LabelLetPattern OptionPrecededEqualSeqExpr ")"
      | "?" UIDENT
      | "?label:" "(" LetPattern OptionPrecededEqualSeqExpr ")"
      | "?label:" PatternVar
      | "~" "(" LabelLetPattern ")"
      | "~" UIDENT
      | "~label:" SimplePattern
      | SimplePattern

    nonterm FunDef ::=
      | "(" "type" UidentList ")" FunDef
      | LabeledSimplePattern FunDef
      | ":" AtomicType "->" SeqExpr
      | "->" SeqExpr

    nonterm FunBinding ::=
      | ":" CoreType "=" SeqExpr
      | StrictBinding

    nonterm StrictBinding ::=
      | "=" SeqExpr
      | LabeledSimplePattern FunBinding
      | "(" "type" UidentList ")" FunBinding

    nonterm LetBindingBodyNoPunning ::=
      | ValIdent ":" "type" UidentList "." CoreType "=" SeqExpr
      | ValIdent ":" TypevarList "." CoreType "=" SeqExpr
      | ValIdent ":" CoreType "=" SeqExpr
      | ValIdent StrictBinding
      | SimplePatternNotIdent ":" CoreType "=" SeqExpr
      | PatternNoExn "=" SeqExpr

    nonterm LetBindingBody ::=
      | LetBindingBodyNoPunning
      | ValIdent

    nonterm LetBindingsExt ::=
      | LetBindingsExt "and" AttributeList LetBindingBody PostItemAttributeList
      | "let" AttributeList RecFlag LetBindingBody PostItemAttributeList

    nonterm OptionPrecededEqualExpr ::=
      | "=" Expr
      | epsilon

    nonterm RecordExprFieldList ::=
      | LabelLongident OptionPrecededEqualExpr ";" RecordExprFieldList
      | LabelLongident OptionPrecededEqualExpr ";"
      | LabelLongident OptionPrecededEqualExpr

    nonterm RecordExprContent ::=
      | SimpleExpr "with" RecordExprFieldList
      | RecordExprFieldList

    nonterm ExprSemiList ::=
      | Expr ";" ExprSemiList
      | Expr ";"
      | Expr

    nonterm SimpleExpr ::=
      | "(" SeqExpr ")"
      | "(" SeqExpr ":" CoreType ")"
      | "begin" AttributeList SeqExpr "end"
      | "begin" AttributeList "end"
      | "(" "module" AttributeList ModuleExpr ")"
      | "(" "module" AttributeList ModuleExpr ":" ModuleType ")"
      | ValLongident
      | Constant
      | ConstrLongident
      | PrefixOp SimpleExpr
      | "!" SimpleExpr
      | SimpleExpr "." LabelLongident
      | ModLongident "." "(" SeqExpr ")"
      | ModLongident "." "(" ")"
      | "{" RecordExprContent "}"
      | ModLongident "." "{" RecordExprContent "}"
      | "[|" ExprSemiList "|]"
      | "[|" "|]"
      | ModLongident "." "[|" ExprSemiList "|]"
      | ModLongident "." "[|" "|]"
      | "[|" ExprSemiList "|]"
      | ModLongident "." "[" ExprSemiList "]"
      | ModLongident "." "[" "]"
      | ModLongident "." "(" "module" AttributeList ModuleExpr ":" ModuleType ")"

    nonterm Expr ::=
      | SimpleExpr
      | "let" "module" AttributeList ModuleName ModuleBindingBody "in" SeqExpr
      | "let" "open" AttributeList ModuleExpr "in" SeqExpr
      | "let" "open" "!" AttributeList ModuleExpr "in" SeqExpr
      | "function" AttributeList MatchCaseList
      | "fun" AttributeList LabeledSimplePattern FunDef
      | "fun" AttributeList "(" "type" UidentList ")"
      | "match" AttributeList SeqExpr "with" MatchCaseList
      | "if" AttributeList SeqExpr "then" Expr "else" Expr
      | "if" AttributeList SeqExpr "then" Expr
      | "assert" AttributeList SimpleExpr
      | "lazy" AttributeList SimpleExpr
      | SimpleExpr LabeledSimpleExprList
      | ExprCommaList
      | ConstrLongident SimpleExpr
      | Expr InfixOp0 Expr
      | Expr InfixOp1 Expr
      | Expr InfixOp2 Expr
      | Expr InfixOp3 Expr
      | Expr InfixOp4 Expr
      | Expr "&&" Expr
      | Expr ":=" Expr
      | Subtractive Expr
      | Additive Expr
      | LetBindingsExt "in" SeqExpr
      | Expr "::" Expr
      | UIDENT "<-" Expr
      | SimpleExpr "." LabelLongident "<-" Expr
      | "_"

    nonterm SeqExpr ::=
      | Expr ";" SeqExpr
      | Expr ";"
      | Expr

    nonterm PatternCommaList ::=
      | PatternCommaList "," Pattern
      | Pattern "," Pattern

    nonterm PatternNoExnCommaList ::=
      | PatternNoExnCommaList "," Pattern
      | PatternNoExn "," Pattern

    nonterm RecordPatFieldList ::=
      | LabelLongident OptionPrecededColonCoreType OptionPrecededEqualPattern ";" RecordPatFieldList
      | LabelLongident OptionPrecededColonCoreType OptionPrecededEqualPattern ";" "_" OptionSemi
      | LabelLongident OptionPrecededColonCoreType OptionPrecededEqualPattern ";"
      | LabelLongident OptionPrecededColonCoreType OptionPrecededEqualPattern

    nonterm PatternSemiList ::=
      | Pattern ";" PatternSemiList
      | Pattern ";"
      | Pattern

    nonterm SimpleDelimitedPattern ::=
      | "{" RecordPatFieldList "}"
      | "[" PatternSemiList "]"
      | "[|" PatternSemiList "|]"
      | "[|" "|]"

    nonterm SimplePatternNotIdent ::=
      | ModLongident "." "(" Pattern ")"
      | ModLongident "." "(" ")"
      | ModLongident "." "[" "]"
      | ModLongident "." SimpleDelimitedPattern
      | ConstrLongident
      | "(" "module" AttributeList ModuleName ":" ModuleType ")"
      | "(" "module" AttributeList ModuleName ")"
      | "(" Pattern ":" CoreType ")"
      | "(" Pattern ")"
      | SimpleDelimitedPattern
      | SignedConstant ".." SignedConstant
      | SignedConstant
      | "_"

    nonterm SimplePattern ::=
      | SimplePatternNotIdent
      | ValIdent

    nonterm PatternGen ::=
      | "lazy" AttributeList SimplePattern
      | ConstrLongident "(" "type" UidentList ")" SimplePattern
      | ConstrLongident Pattern
      | SimplePattern

    nonterm Pattern ::=
      | Pattern "|" Pattern
      | PatternCommaList
      | Pattern "as" ValIdent
      | PatternGen
      | Pattern Attribute
      | Pattern "::" Pattern

    nonterm PatternNoExn ::=
      | PatternNoExn "::" Pattern
      | PatternNoExn Attribute
      | PatternGen
      | PatternNoExn "as" ValIdent
      | PatternNoExnCommaList
      | PatternNoExn "|" Pattern

    nonterm ModuleName ::=
      | CIDENT
      | "_"

    nonterm FunctorArg ::=
      | "(" ModuleName ":" ModuleType ")"
      | "(" ")"

    nonterm FunctorArgList ::=
      | FunctorArgList FunctorArg
      | FunctorArg

    nonterm ParenModuleExpr ::=
      | "(" ModuleExpr ":" ModuleType ")"
      | "(" ModuleExpr ")"
      | "(" "val" AttributeList Expr ")"
      | "(" "val" AttributeList Expr ":" ModuleType ")"

    nonterm ModuleExpr ::=
      | "struct" AttributeList Structure "end"
      | "functor" AttributeList FunctorArgList "->" ModuleExpr
      | ParenModuleExpr
      | ModuleExpr Attribute
      | ModLongident
      | ModuleExpr ParenModuleExpr
      | ModuleExpr "(" ")"

    nonterm TypeVariance ::=
      | PrefixOp
      | InfixOp2
      | "+"
      | "-"
      | "+" "!"
      | "!" "+"
      | "-" "!"
      | "!" "-"
      | epsilon

    nonterm TypeVariable ::=
      | "'" Ident
      | "_"

    nonterm TypeParameter ::=
      | TypeVariance TypeVariable

    nonterm TypeParameterList ::=
      | TypeParameterList "," TypeParameter
      | TypeParameter

    nonterm TypeParameters ::=
      | "(" TypeParameterList ")"
      | TypeParameter
      | epsilon

    nonterm WithTypeBinder ::=
      | "=" "private"
      | "="

    nonterm WithConstraint ::=
      | "type" TypeParameters LabelLongident WithTypeBinder AliasType
      | "type" TypeParameters LabelLongident ":=" AliasType
      | "module" ModLongident "=" ModExtLongident
      | "module" ModLongident ":=" ModExtLongident
      | "module" "type" MtyLongident "=" ModuleType
      | "module" "type" MtyLongident ":=" ModuleType

    nonterm WithConstraintList ::=
      | WithConstraintList "and" WithConstraint
      | WithConstraint

    nonterm ModuleType ::=
      | "sig" AttributeList Signature "end"
      | "functor" AttributeList FunctorArgList "->" ModuleType
      | "module" "type" "of" AttributeList ModuleExpr
      | "(" ModuleType ")"
      | ModuleType Attribute
      | MtyLongident
      | ModuleType "->" ModuleType
      | ModuleType "with" WithConstraintList

    nonterm LongidentModExtLongidentCident ::=
      | ModExtLongident "." CIDENT
      | CIDENT

    nonterm ModExtLongident ::=
      | ModExtLongident "(" ModExtLongident ")"
      | LongidentModExtLongidentCident

    nonterm MtyLongident ::=
      | ModExtLongident "." Ident
      | Ident

    nonterm LabelLongident ::=
      | ModLongident "." UIDENT
      | UIDENT

    nonterm ValLongident ::=
      | ModLongident "." ValIdent
      | ValIdent

    nonterm TypeLongident ::=
      | ModExtLongident "." UIDENT
      | UIDENT

    nonterm ModLongident ::=
      | ModLongident "." CIDENT
      | CIDENT

    nonterm ConstrExtraNonprefixIdent ::=
      | "[" "]"
      | "(" ")"
      | "false"
      | "true"

    nonterm ConstrIdent ::=
      | ConstrExtraNonprefixIdent
      | "(" "::" ")"
      | CIDENT

    nonterm ConstrLongident ::=
      | ConstrExtraNonprefixIdent
      | ModLongident "(" "::" ")"
      | ModLongident
      | "(" "::" ")"

    nonterm RecFlag ::=
      | "rec"
      | epsilon

    nonterm PrivateFlag ::=
      | "private"
      | epsilon

    nonterm MutableFlag ::=
      | "mutable"
      | epsilon

    nonterm CoreType ::=
      | AliasType
      | CoreType Attribute

    nonterm CoreTypeList ::=
      | CoreTypeList "," CoreType
      | CoreType "," CoreType

    nonterm AtomicType ::=
      | "(" CoreType ")"
      | "(" "module" AttributeList ModuleType ")"
      | "'" Ident
      | "_"
      | TypeLongident
      | AtomicType TypeLongident
      | "(" CoreTypeList ")" TypeLongident

    nonterm AtomicTypeTuple ::=
      | AtomicTypeTuple "*" AtomicType
      | AtomicType "*" AtomicType

    nonterm TupleType ::=
      | AtomicType
      | AtomicTypeTuple

    nonterm OptLabel ::=
      | "?label:"
      | "?" UIDENT ":"

    nonterm FunctionType ::=
      | OptLabel TupleType "->" FunctionType
      | UIDENT ":" TupleType "->" FunctionType
      | TupleType "->" FunctionType
      | TupleType

    nonterm AliasType ::=
      | FunctionType
      | AliasType "as" "'" Ident

    nonterm TypevarList ::=
      | "'" Ident
      | TypevarList "'" Ident

    nonterm PossiblyPolyCoreType ::=
      | TypevarList "." CoreType
      | CoreType

    nonterm ValueDescription ::=
      | "val" AttributeList ValIdent ":" PossiblyPolyCoreType PostItemAttributeList

    nonterm Payload ::=
      | Structure
      | ":" Signature
      | ":" CoreType
      | "?" Pattern
      | "?" Pattern "when" SeqExpr

    nonterm AttrId ::=
      | SingleAttrId "." AttrId
      | SingleAttrId

    nonterm Attribute ::=
      | "[@" AttrId Payload "]"

    nonterm PostItemAttribute ::=
      | "[@@" AttrId Payload "]"

    nonterm FloatingAttribute ::=
      | "[@@@" AttrId Payload "]"

    nonterm RawStringList ::=
      | RawStringList ISTRING
      | ISTRING

    nonterm PrimitiveDeclaration ::=
      | "external" AttributeList ValIdent ":" PossiblyPolyCoreType "=" RawStringList
      PostItemAttributeList

    nonterm GenericTypeDeclarationNonrecFlagTypeKind ::=
      | "type" AttributeList TypeParameters UIDENT TypeKind PostItemAttributeList
      | "type" AttributeList "nonrec" TypeParameters UIDENT TypeKind PostItemAttributeList

    nonterm ConstructorDeclarations ::=
      | ConstructorDeclarationList
      | "|"

    nonterm NonemptyTypeKind ::=
      | CoreType "=" "private" "{" LabelDeclarations "}"
      | CoreType "=" "{" LabelDeclarations "}"
      | "private" "{" LabelDeclarations "}"
      | "{" LabelDeclarations "}"
      | CoreType "=" "private" ".."
      | CoreType "=" ".."
      | "private" ".."
      | ".."
      | CoreType "=" "private" ConstructorDeclarations
      | CoreType "=" ConstructorDeclarations
      | "private" ConstructorDeclarations
      | ConstructorDeclarations
      | "private" CoreType
      | CoreType

    nonterm TypeKind ::=
      | "=" NonemptyTypeKind
      | epsilon

    nonterm GenericAndTypeDeclarationTypeKindList ::=
      | "and" AttributeList TypeParameters UIDENT TypeKind PostItemAttributeList
      GenericAndTypeDeclarationTypeKindList
      | epsilon

    nonterm GenericTypeDeclarationNoNonrecFlagTypeSubstKind ::=
      | "type" AttributeList "nonrec" TypeParameters UIDENT ":=" NonemptyTypeKind
      PostItemAttributeList
      | "type" AttributeList TypeParameters UIDENT ":=" NonemptyTypeKind PostItemAttributeList

    nonterm GenericAndTypeDeclarationTypeSubstKindList ::=
      | "and" AttributeList TypeParameters UIDENT ":=" NonemptyTypeKind PostItemAttributeList
      GenericAndTypeDeclarationTypeSubstKindList
      | epsilon

    nonterm GenericConstructorDeclarationBar ::=
      | "|" ConstrIdent GeneralizedConstructorArguments AttributeList

    nonterm PossiblyPolyCoreTypeNoAttr ::=
      | TypevarList "." AliasType

    nonterm LabelDeclaration ::=
      | MutableFlag UIDENT ":" PossiblyPolyCoreTypeNoAttr AttributeList

    nonterm LabelDeclarationSemi ::=
      | MutableFlag UIDENT ":" PossiblyPolyCoreTypeNoAttr AttributeList ";" AttributeList

    nonterm LabelDeclarations ::=
      | LabelDeclarationSemi LabelDeclarations
      | LabelDeclarationSemi
      | LabelDeclaration

    nonterm ConstructorArguments ::=
      | "{" LabelDeclarations "}"
      | AtomicTypeTuple
      | AtomicType

    nonterm GeneralizedConstructorArguments ::=
      | ":" TypevarList "." AtomicType
      | ":" AtomicType
      | ":" TypevarList "." ConstructorArguments "->" AtomicType
      | ":" ConstructorArguments "->" AtomicType
      | "of" ConstructorArguments
      | epsilon

    nonterm GenericConstructorDeclarationEpsilon ::=
      | "|" ConstrIdent GeneralizedConstructorArguments AttributeList

    nonterm ConstructorDeclarationList ::=
      | ConstructorDeclarationList GenericConstructorDeclarationBar
      | GenericConstructorDeclarationBar
      | GenericConstructorDeclarationEpsilon

    nonterm ModuleDeclarationBody ::=
      | FunctorArg ModuleDeclarationBody
      | ":" ModuleType

    nonterm AndModuleDeclarationList ::=
      | "and" AttributeList ModuleName ":" ModuleType PostItemAttributeList AndModuleDeclarationList
      | epsilon

    nonterm OptionPrecededEqualModuleType ::=
      | "=" ModuleType
      | epsilon

    nonterm ModuleTypeDeclaration ::=
      | "module" "type" AttributeList Ident OptionPrecededEqualModuleType PostItemAttributeList

    nonterm ModuleBindingBody ::=
      | FunctorArg ModuleBindingBody
      | ":" ModuleType "=" ModuleExpr
      | "=" ModuleExpr

    nonterm SignatureItem ::=
      | FloatingAttribute
      | ValueDescription
      | PrimitiveDeclaration
      | GenericTypeDeclarationNonrecFlagTypeKind GenericAndTypeDeclarationTypeKindList
      | GenericTypeDeclarationNoNonrecFlagTypeSubstKind GenericAndTypeDeclarationTypeSubstKindList
      | "type" AttributeList TypeParameters TypeLongident "+=" PrivateFlag
      ConstructorDeclarationList PostItemAttributeList
      | "type" AttributeList "nonrec" TypeParameters TypeLongident "+=" PrivateFlag
      ConstructorDeclarationList PostItemAttributeList
      | "module" AttributeList ModuleName ModuleDeclarationBody PostItemAttributeList
      | "module" AttributeList ModuleName "=" ModLongident PostItemAttributeList
      | "module" AttributeList CIDENT ":=" ModExtLongident PostItemAttributeList
      | "module" AttributeList "rec" ModuleName ":" ModuleType PostItemAttributeList
      AndModuleDeclarationList
      | ModuleTypeDeclaration
      | "module" "type" AttributeList Ident ":=" ModuleType PostItemAttributeList
      | "open" AttributeList ModExtLongident PostItemAttributeList
      | "open" "!" AttributeList ModExtLongident PostItemAttributeList
      | "include" AttributeList ModuleType PostItemAttributeList

    nonterm Signature ::=
      | SignatureItem Signature
      | epsilon

    nonterm ExtensionConststructorRebindBar ::=
      | "|" ConstrIdent "=" ConstrLongident AttributeList

    nonterm ExtensionConstructorRebindEpsilon ::=
      | ConstrIdent "=" ConstrLongident AttributeList

    nonterm ExtensionConstructorList ::=
      | ExtensionConstructorList GenericConstructorDeclarationBar
      | ExtensionConstructorList ExtensionConststructorRebindBar
      | GenericConstructorDeclarationBar
      | ExtensionConststructorRebindBar
      | GenericConstructorDeclarationEpsilon
      | ExtensionConstructorRebindEpsilon

    nonterm AndModuleBindingList ::=
      | "and" AttributeList ModuleName ModuleBindingBody PostItemAttributeList AndModuleBindingList
      | epsilon

    nonterm StructureItem ::=
      | LetBindingsExt
      | FloatingAttribute
      | PrimitiveDeclaration
      | ValueDescription
      | GenericTypeDeclarationNonrecFlagTypeKind GenericAndTypeDeclarationTypeKindList
      | "type" AttributeList TypeParameters TypeLongident "+=" PrivateFlag
      ExtensionConstructorList PostItemAttributeList
      | "type" AttributeList "nonrec" TypeParameters TypeLongident "+=" PrivateFlag
      ExtensionConstructorList PostItemAttributeList
      | "module" AttributeList ModuleName ModuleBindingBody PostItemAttributeList
      | "module" AttributeList "rec" ModuleName ModuleBindingBody PostItemAttributeList
      AndModuleBindingList
      | ModuleTypeDeclaration
      | "open" AttributeList ModuleExpr PostItemAttributeList
      | "open" "!" AttributeList ModuleExpr PostItemAttributeList
      | "include" AttributeList ModuleExpr PostItemAttributeList

    nonterm StructureItemList ::=
      | StructureItem StructureItemList
      | epsilon

    nonterm Structure ::=
      | SeqExpr PostItemAttributeList StructureItemList
      | StructureItemList

    start Mli ::=
      | Signature END_OF_INPUT

    start Ml ::=
      | Structure END_OF_INPUT
