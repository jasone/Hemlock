open Basis
open! Basis.Rudiments

include hocc
    # Precedences.

    # Keywords.
    token AND "and"
    token AS "as"
    token ASSERT "assert"
    token BEGIN "begin"
    token ELSE "else"
    token END "end"
    token EXTERNAL "external"
    token FALSE "false"
    token FUN "fun"
    token FUNCTION "function"
    token FUNCTOR "functor"
    token IF "if"
    token IN "in"
    token IMPORT "import"
    token INCLUDE "include"
    token LAZY "lazy"
    token LET "let"
    token MATCH "match"
    token MOD "mod"
    token MODULE "module"
    token MUTABLE "mutable"
    token NONREC "nonrec"
    token OF "of"
    token OPEN "open"
    token PRIVATE "private"
    token REC "rec"
    token SIG "sig"
    token STRUCT "struct"
    token THEN "then"
    token TRUE "true"
    token TYPE "type"
    token VAL "val"
    token WHEN "when"
    token WITH "with"

    # Operators.
    # Prefix.
    token TILDE_OP
    token QMARK_OP
    # Infix.
    token STAR_STAR_OP
    token STAR_OP
    token SLASH_OP
    token PCT_OP
    token PCT "\%"
    token PLUS_OP
    token PLUS_DOT "+."
    token MINUS_OP
    token MINUS_DOT "-."
    token AT_OP
    token CARET_OP
    token DOLLAR_OP
    token LT_OP
    token LT_MINUS "<-"
    token EQ_OP
    token GT_OP
    token BAR_OP
    token COLON_OP
    token DOT_OP

    # Punctuation.
    token TILDE "~"
    token QMARK "?"
    token STAR "*"
    token PLUS "+"
    token PLUS_EQ "+="
    token MINUS "-"
    token LT "<"
    token LT_EQ "<="
    token EQ "="
    token LT_GT "<>"
    token GT_EQ ">="
    token GT ">"
    token COMMA ","
    token DOT "."
    token DOT_DOT ".."
    token SEMI ";"
    token COLON ":"
    token COLON_COLON "::"
    token COLON_EQ ":="
    token LPAREN "("
    token RPAREN ")"
    token LBRACK "["
    token RBRACK "]"
    token LCURLY "{"
    token RCURLY "}"
    token BAR "|"
    token LARRAY "[|"
    token RARRAY "|]"
    token BSLASH "\\"
    token TICK "'"
    token AMP_AMP "&&" # OCaml-specefic.
    token XMARK "!"
    token ARROW "->"

    # Composite.
    token TILDE_UIDENT_COLON
    token QMARK_UIDENT_COLON
    token LBRACKET_AT "[@"
    token LBRACKET_AT_AT "[@@"
    token LBRACKET_AT_AT_AT "[@@@"

    # Miscellaneous.
    token WHITESPACE
    token PAREN_COMMENT
    token USCORE "_"
    token UIDENT
    token CIDENT
    token CODEPOINT
    token QSTRING
    token ISTRING
    token R64
    token LONG
    token END_OF_INPUT

    nonterm PrefixOp ::=
      | TILDE_OP
      | "~"
      | QMARK_OP
      | "?"

    nonterm InfixOp4 ::=
      | STAR_STAR_OP

    nonterm InfixOp3 ::=
      | STAR_OP
      | "*"
      | SLASH_OP
      | PCT_OP
      | "\%"
      | "mod"

    nonterm InfixOp2 ::=
      | MINUS_OP
      | "-"
      | "-."
      | PLUS_OP
      | "+"
      | "+."
      | "+="

    nonterm InfixOp1 ::=
      | AT_OP
      | CARET_OP

    nonterm InfixOp0 ::=
      | BAR_OP
      | DOLLAR_OP
      | LT_OP
      | "<"
      | "<="
      | "<>"
      | EQ_OP
      | "="
      | GT_OP
      | ">="
      | ">"
      | BAR_OP
      | "|"

    nonterm XXX ::= epsilon

    nonterm Constant ::=
      | LONG
      | CODEPOINT
      | QSTRING
      | ISTRING
      | R64

    nonterm SignedConstant ::=
      | Constant
      | "-" LONG
      | "-" R64
      | "+" LONG
      | "+" R64

    nonterm SingleAttrId ::=
      | UIDENT
      | CIDENT
      | "and"
      | "as"
      | "assert"
      | "begin"
      | "else"
      | "end"
      | "external"
      | "false"
      | "fun"
      | "function"
      | "functor"
      | "if"
      | "in"
      | "include"
      | "lazy"
      | "let"
      | "match"
      | "module"
      | "mutable"
      | "nonrec"
      | "of"
      | "open"
      | "private"
      | "rec"
      | "sig"
      | "struct"
      | "then"
      | "true"
      | "type"
      | "val"
      | "when"
      | "with"

    nonterm Operator ::=
      | TILDE_OP
      | QMARK_OP
      | "!"
      | STAR_STAR_OP
      | STAR_OP
      | SLASH_OP
      | PCT_OP
      | PLUS_OP
      | MINUS_OP
      | AT_OP
      | CARET_OP
      | DOLLAR_OP
      | LT_OP
      | EQ_OP
      | GT_OP
      | BAR_OP
      | COLON_OP
      | DOT_OP
      | "+"
      | "-"
      | "*"
      | "="
      | "<"
      | ">"
      | "&&"
      | ":="

    nonterm Subtractive ::=
      | "-"
      | "-."

    nonterm Additive ::=
      | "+"
      | "+."

    nonterm OptionSemi ::=
      | ";"
      | epsilon

    nonterm OptionPrecededColonCoreType ::=
      | ":" CoreType
      | epsilon

    nonterm OptionPrecededEqualPattern ::=
      | "=" Pattern
      | epsilon

    nonterm ListAttribute ::=
      | Attribute ListAttribute
      | epsilon

    nonterm ListPostItemAttribute ::=
      | PostItemAttribute ListPostItemAttribute
      | epsilon

    nonterm ValExtraIdent ::=
      | "(" Operator ")"

    nonterm Ident ::=
      | UIDENT
      | CIDENT

    nonterm ValIdent ::=
      | UIDENT
      | ValExtraIdent

    nonterm MatchCase ::=
      | Pattern "->" SeqExpr
      | Pattern "when" SeqExpr "->" SeqExpr
      | Pattern "->" "."

    nonterm ReversedPrecededOrSeparatedNonemptyLlistBarMatchCase ::=
      | ReversedPrecededOrSeparatedNonemptyLlistBarMatchCase "|" MatchCase
      | "|" MatchCase
      | MatchCase

    nonterm LabeledSimpleExpr ::=
      | SimpleExpr
      | TILDE_UIDENT_COLON SimpleExpr
      | "~" UIDENT
      | "~" "(" UIDENT TypeConstraint ")"
      | "?" UIDENT
      | QMARK_UIDENT_COLON SimpleExpr

    nonterm ReversedNonemptyLlistLabeledSimpleExpr ::=
      | ReversedNonemptyLlistLabeledSimpleExpr LabeledSimpleExpr
      | LabeledSimpleExpr

    nonterm ReversedSeparatedNontrivialLlistCommaExpr ::=
      | ReversedSeparatedNontrivialLlistCommaExpr "," Expr
      | Expr "," Expr

    nonterm LabelLetPattern ::=
      | UIDENT ":" CoreType
      | UIDENT

    nonterm OptionPrecededEqualSeqExpr ::=
      | "=" SeqExpr
      | epsilon

    nonterm LetPattern ::=
      | Pattern ":" CoreType
      | Pattern

    nonterm PatternVar ::=
      | UIDENT
      | "_"

    nonterm LabeledSimplePattern ::=
      | "?" "(" LabelLetPattern OptionPrecededEqualSeqExpr ")"
      | "?" UIDENT
      | QMARK_UIDENT_COLON "(" LetPattern OptionPrecededEqualSeqExpr ")"
      | QMARK_UIDENT_COLON PatternVar
      | "~" "(" LabelLetPattern ")"
      | "~" UIDENT
      | TILDE_UIDENT_COLON SimplePattern
      | SimplePattern

    nonterm FunDef ::=
      | "(" "type" NonemptyListMkrhsLident ")" FunDef
      | LabeledSimplePattern FunDef
      | ":" AtomicType "->" SeqExpr
      | "->" SeqExpr

    nonterm AndLetBinding ::=
      | "and" ListAttribute LetBindingBody ListPostItemAttribute

    nonterm FunBinding ::=
      | TypeConstraint "=" SeqExpr
      | StrictBinding

    nonterm StrictBinding ::=
      | "=" SeqExpr
      | LabeledSimplePattern FunBinding
      | "(" "type" NonemptyListMkrhsLident ")" FunBinding

    nonterm LetBindingBodyNoPunning ::=
      | ValIdent ":" "type" NonemptyListMkrhsLident "." CoreType "=" SeqExpr
      | ValIdent ":" ReversedNonEmptyLlistTypevar "." CoreType "=" SeqExpr
      | ValIdent TypeConstraint "=" SeqExpr
      | ValIdent StrictBinding
      | SimplePatternNotIdent ":" CoreType "=" SeqExpr
      | PatternNoExn "=" SeqExpr

    nonterm LetBindingBody ::=
      | LetBindingBodyNoPunning
      | ValIdent

    nonterm LetBindingsExt ::=
      | LetBindingsExt AndLetBinding
      | "let" ListAttribute RecFlag LetBindingBody ListPostItemAttribute

    nonterm TypeConstraint ::=
      | ":" CoreType

    nonterm OptionPrecededEqualExpr ::=
      | "=" Expr
      | epsilon

    nonterm SeparatedOrTerminatedNonemptyListSemiRecordExprField ::=
      | LabelLongident OptionPrecededEqualExpr ";"
      SeparatedOrTerminatedNonemptyListSemiRecordExprField
      | LabelLongident OptionPrecededEqualExpr ";"
      | LabelLongident OptionPrecededEqualExpr

    nonterm RecordExprContent ::=
      | SimpleExpr "with" SeparatedOrTerminatedNonemptyListSemiRecordExprField
      | SeparatedOrTerminatedNonemptyListSemiRecordExprField

    nonterm SeparatedOrTerminatedNonemptyListSemiExpr ::=
      | Expr ";" SeparatedOrTerminatedNonemptyListSemiExpr
      | Expr ";"
      | Expr

    nonterm SimpleExpr ::=
      | "(" SeqExpr ")"
      | "(" SeqExpr TypeConstraint ")"
      | "begin" ListAttribute SeqExpr "end"
      | "begin" ListAttribute "end"
      | "(" "module" ListAttribute ModuleExpr ")"
      | "(" "module" ListAttribute ModuleExpr ":" ModuleType ")"
      | ValLongident
      | Constant
      | ConstrLongident
      | PrefixOp SimpleExpr
      | "!" SimpleExpr
      | SimpleExpr "." LabelLongident
      | ModLongident "." "(" SeqExpr ")"
      | ModLongident "." "(" ")"
      | "{" RecordExprContent "}"
      | ModLongident "." "{" RecordExprContent "}"
      | "[|" SeparatedOrTerminatedNonemptyListSemiExpr "|]"
      | "[|" "|]"
      | ModLongident "." "[|" SeparatedOrTerminatedNonemptyListSemiExpr "|]"
      | ModLongident "." "[|" "|]"
      | "[|" SeparatedOrTerminatedNonemptyListSemiExpr "|]"
      | ModLongident "." "[" SeparatedOrTerminatedNonemptyListSemiExpr "]"
      | ModLongident "." "[" "]"
      | ModLongident "." "(" "module" ListAttribute ModuleExpr ":" ModuleType ")"

    nonterm Expr ::=
      | SimpleExpr
      | "let" "module" ListAttribute ModuleName ModuleBindingBody "in" SeqExpr
      | "let" "open" ListAttribute ModuleExpr "in" SeqExpr
      | "let" "open" "!" ListAttribute ModuleExpr "in" SeqExpr
      | "function" ListAttribute ReversedPrecededOrSeparatedNonemptyLlistBarMatchCase
      | "fun" ListAttribute LabeledSimplePattern FunDef
      | "fun" ListAttribute "(" "type" NonemptyListMkrhsLident ")"
      | "match" ListAttribute SeqExpr "with" ReversedPrecededOrSeparatedNonemptyLlistBarMatchCase
      | "if" ListAttribute SeqExpr "then" Expr "else" Expr
      | "if" ListAttribute SeqExpr "then" Expr
      | "assert" ListAttribute SimpleExpr
      | "lazy" ListAttribute SimpleExpr
      | SimpleExpr ReversedNonemptyLlistLabeledSimpleExpr
      | ReversedSeparatedNontrivialLlistCommaExpr
      | ConstrLongident SimpleExpr
      | Expr InfixOp0 Expr
      | Expr InfixOp1 Expr
      | Expr InfixOp2 Expr
      | Expr InfixOp3 Expr
      | Expr InfixOp4 Expr
      | Expr "&&" Expr
      | Expr ":=" Expr
      | Subtractive Expr
      | Additive Expr
      | LetBindingsExt "in" SeqExpr
      | Expr "::" Expr
      | UIDENT "<-" Expr
      | SimpleExpr "." LabelLongident "<-" Expr
      | "_"

    nonterm SeqExpr ::=
      | Expr ";" SeqExpr
      | Expr ";"
      | Expr

    nonterm PatternCommaListPattern ::=
      | PatternCommaListPattern "," Pattern
      | Pattern "," Pattern

    nonterm PatternCommaListPatternNoExn ::=
      | PatternCommaListPatternNoExn "," Pattern
      | PatternNoExn "," Pattern

    nonterm ListxSemiRecordPatFieldUnderscore ::=
      | LabelLongident OptionPrecededColonCoreType OptionPrecededEqualPattern ";"
      ListxSemiRecordPatFieldUnderscore
      | LabelLongident OptionPrecededColonCoreType OptionPrecededEqualPattern ";" "_" OptionSemi
      | LabelLongident OptionPrecededColonCoreType OptionPrecededEqualPattern ";"
      | LabelLongident OptionPrecededColonCoreType OptionPrecededEqualPattern

    nonterm SeparatedOrTerminatedNonemptyListSemiPattern ::=
      | Pattern ";" SeparatedOrTerminatedNonemptyListSemiPattern
      | Pattern ";"
      | Pattern

    nonterm SimpleDelimitedPattern ::=
      | "{" ListxSemiRecordPatFieldUnderscore "}"
      | "[" SeparatedOrTerminatedNonemptyListSemiPattern "]"
      | "[|" SeparatedOrTerminatedNonemptyListSemiPattern "|]"
      | "[|" "|]"

    nonterm SimplePatternNotIdent ::=
      | ModLongident "." "(" Pattern ")"
      | ModLongident "." "(" ")"
      | ModLongident "." "[" "]"
      | ModLongident "." SimpleDelimitedPattern
      | ConstrLongident
      | "(" "module" ListAttribute ModuleName ":" ModuleType ")"
      | "(" "module" ListAttribute ModuleName ")"
      | "(" Pattern ":" CoreType ")"
      | "(" Pattern ")"
      | SimpleDelimitedPattern
      | SignedConstant ".." SignedConstant
      | SignedConstant
      | "_"

    nonterm SimplePattern ::=
      | SimplePatternNotIdent
      | ValIdent

    nonterm NonemptyListMkrhsLident ::=
      | UIDENT NonemptyListMkrhsLident
      | UIDENT

    nonterm PatternGen ::=
      | "lazy" ListAttribute SimplePattern
      | ConstrLongident "(" "type" NonemptyListMkrhsLident ")" SimplePattern
      | ConstrLongident Pattern
      | SimplePattern

    nonterm Pattern ::=
      | Pattern "|" Pattern
      | PatternCommaListPattern
      | Pattern "as" ValIdent
      | PatternGen
      | Pattern Attribute
      | Pattern "::" Pattern

    nonterm PatternNoExn ::=
      | PatternNoExn "::" Pattern
      | PatternNoExn Attribute
      | PatternGen
      | PatternNoExn "as" ValIdent
      | PatternCommaListPatternNoExn
      | PatternNoExn "|" Pattern

    nonterm ModuleName ::=
      | CIDENT
      | "_"

    nonterm FunctorArg ::=
      | "(" ModuleName ":" ModuleType ")"
      | "(" ")"

    nonterm ReversedNonemptyLlistFunctorArg ::=
      | ReversedNonemptyLlistFunctorArg FunctorArg
      | FunctorArg

    nonterm ParenModuleExpr ::=
      | "(" ModuleExpr ":" ModuleType ")"
      | "(" ModuleExpr ")"
      | "(" "val" ListAttribute Expr ")"
      | "(" "val" ListAttribute Expr ":" ModuleType ")"

    nonterm ModuleExpr ::=
      | "struct" ListAttribute Structure "end"
      | "functor" ListAttribute ReversedNonemptyLlistFunctorArg "->" ModuleExpr
      | ParenModuleExpr
      | ModuleExpr Attribute
      | ModLongident
      | ModuleExpr ParenModuleExpr
      | ModuleExpr "(" ")"

    nonterm TypeVariance ::=
      | PrefixOp
      | InfixOp2
      | "+"
      | "-"
      | "+" "!"
      | "!" "+"
      | "-" "!"
      | "!" "-"
      | epsilon

    nonterm TypeVariable ::=
      | "'" Ident
      | "_"

    nonterm TypeParameter ::=
      | TypeVariance TypeVariable

    nonterm ReversedSeparatedNonemptyLlistCommaTypeParameter ::=
      | ReversedSeparatedNonemptyLlistCommaTypeParameter "," TypeParameter
      | TypeParameter

    nonterm TypeParameters ::=
      | "(" ReversedSeparatedNonemptyLlistCommaTypeParameter ")"
      | TypeParameter
      | epsilon

    nonterm WithTypeBinder ::=
      | "="
      | "=" "private"

    nonterm WithConstraint ::=
      | "type" TypeParameters LabelLongident WithTypeBinder AliasType
      | "type" TypeParameters LabelLongident ":=" AliasType
      | "module" ModLongident "=" ModExtLongident
      | "module" ModLongident ":=" ModExtLongident
      | "module" "type" MtyLongident "=" ModuleType
      | "module" "type" MtyLongident ":=" ModuleType

    nonterm ReversedSeparatedNonemptyLlistAndWithConstraint ::=
      | ReversedSeparatedNonemptyLlistAndWithConstraint "and" WithConstraint
      | WithConstraint

    nonterm ModuleType ::=
      | "sig" ListAttribute Signature "end"
      | "functor" ListAttribute ReversedNonemptyLlistFunctorArg "->" ModuleType
      | "module" "type" "of" ListAttribute ModuleExpr
      | "(" ModuleType ")"
      | ModuleType Attribute
      | MtyLongident
      | ModuleType "->" ModuleType
      | ModuleType "with" ReversedSeparatedNonemptyLlistAndWithConstraint

    nonterm LongidentModExtLongidentCident ::=
      | ModExtLongident "." CIDENT
      | CIDENT

    nonterm ModExtLongident ::=
      | ModExtLongident "(" ModExtLongident ")"
      | LongidentModExtLongidentCident

    nonterm MtyLongident ::=
      | ModExtLongident "." Ident
      | Ident

    nonterm LabelLongident ::=
      | ModLongident "." UIDENT
      | UIDENT

    nonterm ValLongident ::=
      | ModLongident "." ValIdent
      | ValIdent

    nonterm TypeLongident ::=
      | ModExtLongident "." UIDENT
      | UIDENT

    nonterm ModLongident ::=
      | ModLongident "." CIDENT
      | CIDENT

    nonterm ConstrExtraNonprefixIdent ::=
      | "[" "]"
      | "(" ")"
      | "false"
      | "true"

    nonterm ConstrIdent ::=
      | ConstrExtraNonprefixIdent
      | "(" "::" ")"
      | CIDENT

    nonterm ConstrLongident ::=
      | ConstrExtraNonprefixIdent
      | ModLongident "(" "::" ")"
      | ModLongident
      | "(" "::" ")"

    nonterm RecFlag ::=
      | "rec"
      | epsilon

    nonterm PrivateFlag ::=
      | "private"
      | epsilon

    nonterm MutableFlag ::=
      | "mutable"
      | epsilon

    nonterm ReversedSeparatedNonemptyLlistCommaCoreType ::=
      | ReversedSeparatedNonemptyLlistCommaCoreType "," CoreType
      | CoreType "," CoreType

    nonterm AtomicType ::=
      | "(" CoreType ")"
      | "(" "module" ListAttribute ModuleType ")"
      | "'" Ident
      | "_"
      | TypeLongident
      | AtomicType TypeLongident
      | "(" ReversedSeparatedNonemptyLlistCommaCoreType ")" TypeLongident

    nonterm ReversedSeparatedNontrivialLlistStarAtomicType ::=
      | ReversedSeparatedNontrivialLlistStarAtomicType "*" AtomicType
      | AtomicType "*" AtomicType

    nonterm TupleType ::=
      | AtomicType
      | ReversedSeparatedNontrivialLlistStarAtomicType

    nonterm OptLabel ::=
      | QMARK_UIDENT_COLON
      | "?" UIDENT ":"

    nonterm FunctionType ::=
      | TupleType
      | OptLabel TupleType "->" FunctionType
      | UIDENT ":" TupleType "->" FunctionType
      | TupleType "->" FunctionType

    nonterm AliasType ::=
      | FunctionType
      | AliasType "as" "'" Ident

    nonterm CoreType ::=
      | AliasType
      | CoreType Attribute

    nonterm ReversedNonEmptyLlistTypevar ::=
      | "'" Ident
      | ReversedNonEmptyLlistTypevar "'" Ident

    nonterm PossiblyPolyCoreType ::=
      | CoreType
      | ReversedNonEmptyLlistTypevar "." CoreType

    nonterm ValueDescription ::=
      | "val" ListAttribute ValIdent ":" PossiblyPolyCoreType ListPostItemAttribute

    nonterm Payload ::=
      | Structure
      | ":" Signature
      | ":" CoreType
      | "?" Pattern
      | "?" Pattern "when" SeqExpr

    nonterm AttrId ::=
      | SingleAttrId
      | SingleAttrId "." AttrId

    nonterm Attribute ::=
      | "[@" AttrId Payload "]"

    nonterm PostItemAttribute ::=
      | "[@@" AttrId Payload "]"

    nonterm FloatingAttribute ::=
      | "[@@@" AttrId Payload "]"

    nonterm NonemptyListRawString ::=
      | NonemptyListRawString ISTRING
      | ISTRING

    nonterm PrimitiveDeclaration ::=
      | "external" ListAttribute ValIdent ":" PossiblyPolyCoreType "=" NonemptyListRawString
      ListPostItemAttribute

    nonterm GenericTypeDeclarationNonrecFlagTypeKind ::=
      | "type" ListAttribute TypeParameters UIDENT TypeKind ListPostItemAttribute
      | "type" ListAttribute "nonrec" TypeParameters UIDENT TypeKind ListPostItemAttribute

    nonterm ConstructorDeclarations ::=
      | ReversedBarLlistExtensionConstructorDeclaration
      | "|"

    nonterm NonemptyTypeKind ::=
      | CoreType "=" "private" "{" LabelDeclarations "}"
      | CoreType "=" "{" LabelDeclarations "}"
      | "private" "{" LabelDeclarations "}"
      | "{" LabelDeclarations "}"
      | CoreType "=" "private" ".."
      | CoreType "=" ".."
      | "private" ".."
      | ".."
      | CoreType "=" "private" ConstructorDeclarations
      | CoreType "=" ConstructorDeclarations
      | "private" ConstructorDeclarations
      | ConstructorDeclarations
      | "private" CoreType
      | CoreType

    nonterm TypeKind ::=
      | "=" NonemptyTypeKind
      | epsilon

    nonterm ListGenericAndTypeDeclarationTypeKind ::=
      | "and" ListAttribute TypeParameters UIDENT TypeKind ListPostItemAttribute
      ListGenericAndTypeDeclarationTypeKind
      | epsilon

    nonterm GenericTypeDeclarationNoNonrecFlagTypeSubstKind ::=
      | "type" ListAttribute "nonrec" TypeParameters UIDENT ":=" NonemptyTypeKind
      ListPostItemAttribute
      | "type" ListAttribute TypeParameters UIDENT ":=" NonemptyTypeKind ListPostItemAttribute

    nonterm ListGenericAndTypeDeclarationTypeSubstKind ::=
      | "and" ListAttribute TypeParameters UIDENT ":=" NonemptyTypeKind ListPostItemAttribute
      ListGenericAndTypeDeclarationTypeSubstKind
      | epsilon

    nonterm GenericConstructorDeclarationBar ::=
      | "|" ConstrIdent GeneralizedConstructorArguments ListAttribute

    nonterm ReversedSeparatedNonemptyLlistStarAtomicType ::=
      | ReversedSeparatedNonemptyLlistStarAtomicType "*" AtomicType
      | AtomicType

    nonterm PossiblyPolyCoreTypeNoAttr ::=
      | ReversedNonEmptyLlistTypevar "." AliasType

    nonterm LabelDeclaration ::=
      | MutableFlag UIDENT ":" PossiblyPolyCoreTypeNoAttr ListAttribute

    nonterm LabelDeclarationSemi ::=
      | MutableFlag UIDENT ":" PossiblyPolyCoreTypeNoAttr ListAttribute ";" ListAttribute

    nonterm LabelDeclarations ::=
      | LabelDeclarationSemi LabelDeclarations
      | LabelDeclarationSemi
      | LabelDeclaration

    nonterm ConstructorArguments ::=
      | "{" LabelDeclarations "}"
      | ReversedSeparatedNonemptyLlistStarAtomicType "*" AtomicType
      | AtomicType

    nonterm GeneralizedConstructorArguments ::=
      | ":" ReversedNonEmptyLlistTypevar "." AtomicType
      | ":" AtomicType
      | ":" ReversedNonEmptyLlistTypevar "." ConstructorArguments "->" AtomicType
      | ":" ConstructorArguments "->" AtomicType
      | "of" ConstructorArguments
      | epsilon

    nonterm GenericConstructorDeclarationEpsilon ::=
      | "|" ConstrIdent GeneralizedConstructorArguments ListAttribute

    nonterm ReversedBarLlistExtensionConstructorDeclaration ::=
      | ReversedBarLlistExtensionConstructorDeclaration GenericConstructorDeclarationBar
      | GenericConstructorDeclarationBar
      | GenericConstructorDeclarationEpsilon

    nonterm ModuleDeclarationBody ::=
      | FunctorArg ModuleDeclarationBody
      | ":" ModuleType

    nonterm ModuleSubst ::=
      | "module" ListAttribute CIDENT ":=" ModExtLongident ListPostItemAttribute

    nonterm ListAndModuleDeclaration ::=
      | "and" ListAttribute ModuleName ":" ModuleType ListPostItemAttribute ListAndModuleDeclaration
      | epsilon

    nonterm OptionPrecededEqualModuleType ::=
      | "=" ModuleType
      | epsilon

    nonterm ModuleTypeDeclaration ::=
      | "module" "type" ListAttribute Ident OptionPrecededEqualModuleType ListPostItemAttribute

    nonterm ModuleBindingBody ::=
      | FunctorArg ModuleBindingBody
      | ":" ModuleType "=" ModuleExpr
      | "=" ModuleExpr

    nonterm ModuleTypeSubst ::=
      | "module" "type" ListAttribute Ident ":=" ModuleType ListPostItemAttribute

    nonterm OpenDescription ::=
      | "open" ListAttribute ModExtLongident ListPostItemAttribute
      | "open" "!" ListAttribute ModExtLongident ListPostItemAttribute

    nonterm SignatureItem ::=
      | FloatingAttribute
      | ValueDescription
      | PrimitiveDeclaration
      | GenericTypeDeclarationNonrecFlagTypeKind ListGenericAndTypeDeclarationTypeKind
      | GenericTypeDeclarationNoNonrecFlagTypeSubstKind ListGenericAndTypeDeclarationTypeSubstKind
      | "type" ListAttribute TypeParameters TypeLongident "+=" PrivateFlag
      ReversedBarLlistExtensionConstructorDeclaration ListPostItemAttribute
      | "type" ListAttribute "nonrec" TypeParameters TypeLongident "+=" PrivateFlag
      ReversedBarLlistExtensionConstructorDeclaration ListPostItemAttribute
      | "module" ListAttribute ModuleName ModuleDeclarationBody ListPostItemAttribute
      | "module" ListAttribute ModuleName "=" ModLongident ListPostItemAttribute
      | ModuleSubst
      | "module" ListAttribute "rec" ModuleName ":" ModuleType ListPostItemAttribute
      ListAndModuleDeclaration
      | ModuleTypeDeclaration
      | ModuleTypeSubst
      | OpenDescription
      | "include" ListAttribute ModuleType ListPostItemAttribute

    nonterm SignatureListElm ::=
      | SignatureItem SignatureListElm
      | epsilon

    nonterm Signature ::=
      | SignatureListElm

    nonterm Structure ::=
      | XXX

    start Mli ::=
      | Signature END_OF_INPUT

    start Ml ::=
      | Structure END_OF_INPUT
