Ordmap {root=Empty}
  min_opt -> None
  max_opt -> None
  0 -> <, <>, >
Ordmap {root=Leaf {k=1; v=10}}
  min_opt -> Some ((1, 10))
  min -> (1, 10)
  max_opt -> Some ((1, 10))
  max -> (1, 10)
  0 -> <[0]=(1, 10), <>, <[0]=(1, 10)
  1 -> =[0]=(1, 10), =(1, 10), =[0]=(1, 10)
  2 -> >[0]=(1, 10), <>, >[0]=(1, 10)
Ordmap {root=Node {l=Empty; k=1; v=10; n=2; h=2; r=Leaf {k=3; v=30}}}
  min_opt -> Some ((1, 10))
  min -> (1, 10)
  max_opt -> Some ((3, 30))
  max -> (3, 30)
  0 -> <[0]=(1, 10), <>, <[0]=(1, 10)
  1 -> =[0]=(1, 10), =(1, 10), =[0]=(1, 10)
  2 -> >[0]=(1, 10), <>, <[1]=(3, 30)
  3 -> =[1]=(3, 30), =(3, 30), =[1]=(3, 30)
  4 -> >[1]=(3, 30), <>, >[1]=(3, 30)
Ordmap {root=Node {l=Leaf {k=1; v=10}; k=3; v=30; n=3; h=2; r=Leaf {k=5; v=50}}}
  min_opt -> Some ((1, 10))
  min -> (1, 10)
  max_opt -> Some ((5, 50))
  max -> (5, 50)
  0 -> <[0]=(1, 10), <>, <[0]=(1, 10)
  1 -> =[0]=(1, 10), =(1, 10), =[0]=(1, 10)
  2 -> >[0]=(1, 10), <>, <[1]=(3, 30)
  3 -> =[1]=(3, 30), =(3, 30), =[1]=(3, 30)
  4 -> >[1]=(3, 30), <>, <[2]=(5, 50)
  5 -> =[2]=(5, 50), =(5, 50), =[2]=(5, 50)
  6 -> >[2]=(5, 50), <>, >[2]=(5, 50)
