      | N_mod_longident "." N_val_ident prec p_DOT

    nonterm N_val_longident ::=
      | N_mk_longident_mod_longident_val_ident_

    nonterm N_label_longident ::=
      | N_mk_longident_mod_longident_LIDENT_

    nonterm N_type_longident ::=
