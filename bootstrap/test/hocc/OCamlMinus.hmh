    nonterm N_private_flag ::=
      | epsilon
      | "private"

    nonterm N_mutable_flag ::=
      | epsilon
      | "mutable"

    nonterm N_subtractive ::=
      | "-" prec p_MINUS
      | "-." prec p_MINUSDOT

    nonterm N_additive ::=
      | "+" prec p_PLUS
      | "+." prec p_PLUSDOT

    nonterm N_optlabel ::=
      | OPTLABEL
      | "?" LIDENT ":"

    nonterm N_single_attr_id ::=
      | LIDENT prec p_LIDENT
      | UIDENT prec p_UIDENT
      | "and" prec p_AND
      | "as" prec p_AS
      | "assert"
      | "begin" prec p_BEGIN
      | "else" prec p_ELSE
      | "end"
      | "external"
      | "false" prec p_FALSE
      | "fun"
      | "function" prec p_FUNCTION
      | "functor"
      | "if"
      | "in" prec p_IN
      | "include"
      | "lazy"
      | "let" prec p_LET
      | "match"
      | "module"
      | "mutable"
      | "nonrec"
      | "of"
      | "open"
      | "private"
      | "rec"
      | "sig"
      | "struct"
      | "then" prec p_THEN
      | "true" prec p_TRUE
      | "type"
      | "val"
      | "when"
      | "with" prec p_WITH

    nonterm N_attr_id ::=
      | N_single_attr_id
      | N_single_attr_id "." N_attr_id prec p_DOT

    nonterm N_attribute ::=
      | "[@" N_attr_id N_payload "]"

    nonterm N_post_item_attribute ::=
      | "[@@" N_attr_id N_payload "]"

    nonterm N_floating_attribute ::=
      | "[@@@" N_attr_id N_payload "]"

    nonterm N_payload ::=
